#!/usr/bin/env bash
# Shortcut for running the PSX Tracker.
#   ./psx update [spreadsheet-id]    Refresh the Daily Performance tab
#   ./psx dry-run [spreadsheet-id]   Show what would change, without writing to the sheet
#   (without an ID, SPREADSHEET_ID from .env is used)
#   ./psx setup <spreadsheet-id>   Build the tracker in a blank Google Sheet
#   ./psx export-template          Save your sheet's structure to template.json
set -euo pipefail

cd "$(dirname "$0")"
PYTHON=.venv/bin/python

if [ ! -x "$PYTHON" ]; then
  echo "Python environment not found. Set it up first:"
  echo "  python3 -m venv .venv && .venv/bin/pip install -r requirements.txt"
  exit 1
fi

case "${1:-}" in
  update)  shift; exec "$PYTHON" update_performance.py "$@" ;;
  dry-run) shift; exec "$PYTHON" update_performance.py --dry-run "$@" ;;
  setup)   shift; exec "$PYTHON" setup_sheet.py "$@" ;;
  export-template) exec "$PYTHON" export_template.py ;;
  *)
    echo "Usage: ./psx <command>"
    echo
    echo "Commands:"
    echo "  update [spreadsheet-id]    Refresh the Daily Performance tab in the Google Sheet"
    echo "  dry-run [spreadsheet-id]   Show what would change, without writing to the sheet"
    echo "  setup <spreadsheet-id>     Build the tracker in a blank Google Sheet"
    echo "  export-template            Save your sheet's structure to template.json"
    echo
    echo "update and dry-run use SPREADSHEET_ID from .env unless you give an ID."
    exit 1
    ;;
esac

# Copy this file to .env and fill in your own values. Never commit .env.

# The long ID in your sheet's URL: docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=

# Path to the Google service account key (JSON), relative to this folder.
GOOGLE_KEY_FILE=service-account.json

# Tab names in your spreadsheet.
TRADE_SHEET=Trade List
PERF_SHEET=Daily Performance
PRICES_SHEET=Latest Prices
DIVIDEND_SHEET=Dividend summary

# How many days back to re-price using the current Trade List on every run.
DAYS_TO_REFILL=30

# PSX Data Portal (only change if PSX moves it).
PSX_BASE_URL=https://dps.psx.com.pk
